# Supabase Postgres connection string (Drizzle ORM).
# Use the pooler connection string for serverless deployments (port 6543).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project URL and publishable key, used by Supabase Auth to send
# magic-link emails. The anon key also works.
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret used to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Public base URL of this application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Timezone used for "today" and appointment expiry checks.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta

# Session lifetime. Magic-link lifetime is configured in Supabase Auth
# (Authentication > Sign In / Providers > Email > Email OTP expiration).
SESSION_TTL_MINUTES=60

# WhatsApp receipt delivery. Supported providers: fonnte, generic, log.
# - fonnte: set FONNTE_TOKEN
# - generic: set WHATSAPP_API_URL (JSON body { target, message })
# - log: only prints the message to the server log
WHATSAPP_PROVIDER=log
FONNTE_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
